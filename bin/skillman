#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual==8.2.8", "pyyaml>=6"]
# ///
"""skillman — TUI for the cold skill library (~/skill-library).

Usage: skillman [project-dir]      (default: git root of the current dir, else the current dir)
Tabs: 1 Library · 2 Packs · 3 Project · 4 Updates · 5 Upstream · 6 Validation · 7 Trash
All logic lives in scripts/skillcore.py next to this file (also usable as a CLI).
Library data: $SKILL_LIBRARY (default ~/skill-library).
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _cand in (_HERE.parent / "scripts", Path(os.environ.get("SKILL_LIBRARY") or "~/skill-library").expanduser() / "scripts"):
    if (_cand / "skillcore.py").exists():
        sys.path.insert(0, str(_cand))
        break
import skillcore as sc  # noqa: E402

from rich.text import Text  # noqa: E402
from textual import on, work  # noqa: E402
from textual.app import App, ComposeResult  # noqa: E402
from textual.binding import Binding  # noqa: E402
from textual.coordinate import Coordinate  # noqa: E402
from textual.containers import Horizontal, Vertical, VerticalScroll  # noqa: E402
from textual.screen import ModalScreen  # noqa: E402
from textual.widgets import (  # noqa: E402
    Button, DataTable, Footer, Header, Input, Label, Markdown, OptionList, Static, TabbedContent, TabPane, TextArea,
)
from textual.widgets.option_list import Option  # noqa: E402

STATE_STYLE = {"ok": "green", "outdated": "yellow", "modified": "magenta", "conflict": "bold red",
               "missing": "red", "invalid": "red", "orphan": "dim", "untracked": "cyan",
               "changed": "yellow", "up-to-date": "green", "removed-upstream": "red", "license-gone": "red",
               "pinned": "blue", "error": "red", "pending-risky": "bold magenta"}


def styled(s: str) -> Text:
    return Text(s, style=STATE_STYLE.get(s, ""))


def fmt_results(res) -> str:
    return "\n".join(f"{'✓' if ok else '✗'} {n}: {m}" for n, ok, m in res) or "(nothing to do)"


# ───────────────────────────── modal screens ─────────────────────────────
class Confirm(ModalScreen[bool]):
    BINDINGS = [Binding("y", "yes", "Yes"), Binding("n,escape", "no", "No")]

    def __init__(self, message: str, danger: bool = False):
        super().__init__()
        self.message, self.danger = message, danger

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(self.message, markup=False, classes="msg")
            with Horizontal(classes="buttons"):
                yield Button("Yes (y)", variant="error" if self.danger else "primary", id="yes")
                yield Button("No (n)", id="no")

    @on(Button.Pressed)
    def pressed(self, ev: Button.Pressed) -> None:
        self.dismiss(ev.button.id == "yes")

    def action_yes(self) -> None:
        self.dismiss(True)

    def action_no(self) -> None:
        self.dismiss(False)


class Ask(ModalScreen[str | None]):
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, prompt: str, value: str = "", placeholder: str = ""):
        super().__init__()
        self.prompt, self.value, self.placeholder = prompt, value, placeholder

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Label(self.prompt)
            yield Input(self.value, placeholder=self.placeholder, id="ask")

    @on(Input.Submitted)
    def submitted(self, ev: Input.Submitted) -> None:
        self.dismiss(ev.value.strip())

    def action_cancel(self) -> None:
        self.dismiss(None)


class Pick(ModalScreen[str | None]):
    """Filterable single choice. options: [(value, label)]"""
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, title: str, options: list[tuple[str, str]]):
        super().__init__()
        self.title_, self.options = title, options

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog tall"):
            yield Label(self.title_)
            yield Input(placeholder="type to filter, ↓ to list, enter to choose", id="pick-filter")
            yield OptionList(id="pick-list")

    def on_mount(self) -> None:
        self._fill("")

    def _fill(self, q: str) -> None:
        ol = self.query_one(OptionList)
        ol.clear_options()
        words = q.lower().split()
        for v, lab in self.options:
            if all(w in f"{v} {lab}".lower() for w in words):
                ol.add_option(Option(f"{v}  {lab}" if lab else v, id=v))
        if ol.option_count:
            ol.highlighted = 0

    @on(Input.Changed, "#pick-filter")
    def changed(self, ev: Input.Changed) -> None:
        self._fill(ev.value)

    @on(Input.Submitted, "#pick-filter")
    def submit_filter(self, ev: Input.Submitted) -> None:
        ol = self.query_one(OptionList)
        if ol.option_count and ol.highlighted is not None:
            self.dismiss(ol.get_option_at_index(ol.highlighted).id)

    def on_key(self, ev) -> None:
        if ev.key == "down" and self.focused is self.query_one("#pick-filter"):
            self.query_one(OptionList).focus()
            ev.stop()

    @on(OptionList.OptionSelected)
    def selected(self, ev: OptionList.OptionSelected) -> None:
        self.dismiss(ev.option.id)

    def action_cancel(self) -> None:
        self.dismiss(None)


class TextView(ModalScreen[None]):
    BINDINGS = [Binding("escape,q", "close", "Close")]

    def __init__(self, title: str, text: str):
        super().__init__()
        self.title_, self.text = title, text

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog full"):
            yield Label(self.title_)
            yield TextArea(self.text, read_only=True, id="tv")
            yield Label("esc / q to close", classes="hint")

    def action_close(self) -> None:
        self.dismiss(None)


# ───────────────────────────── base tab ─────────────────────────────
class TabBody(Vertical):
    """Each tab: a DataTable with multi-select keyed rows + reload()."""
    table_id = ""

    def __init__(self, **kw):
        super().__init__(**kw)
        self.keys: list[str] = []
        self.selected: set[str] = set()

    @property
    def app_(self) -> "SkillMan":
        return self.app  # type: ignore[return-value]

    @property
    def table(self) -> DataTable:
        return self.query_one(f"#{self.table_id}", DataTable)

    def cursor_key(self) -> str | None:
        t = self.table
        if not self.keys or t.cursor_row is None or t.cursor_row >= len(self.keys):
            return None
        return self.keys[t.cursor_row]

    def targets(self) -> list[str]:
        """Selected rows, else the row under the cursor."""
        if self.selected:
            return [k for k in self.keys if k in self.selected] or sorted(self.selected)
        k = self.cursor_key()
        return [k] if k else []

    def mark(self, key: str) -> str:
        return "●" if key in self.selected else " "

    def action_toggle(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        self.selected.symmetric_difference_update({k})
        t = self.table
        row = t.cursor_row
        t.update_cell_at(Coordinate(row, 0), self.mark(k))
        if row + 1 < t.row_count:
            t.move_cursor(row=row + 1)

    def action_clear_sel(self) -> None:
        self.selected.clear()
        self.reload()

    @staticmethod
    def reset_table(t: DataTable) -> None:
        """clear() keeps auto column widths from the widest rows ever shown; rebuild columns instead."""
        labels = [c.label for c in t.columns.values()]
        t.clear(columns=True)
        t.add_columns(*labels)

    def fill(self, rows: list[tuple[str, list]]) -> None:
        t = self.table
        keep = self.cursor_key()
        self.reset_table(t)
        self.keys = []
        for key, cells in rows:
            t.add_row(self.mark(key), *cells, key=key)
            self.keys.append(key)
        if keep in self.keys:
            t.move_cursor(row=self.keys.index(keep))

    def reload(self) -> None:  # override
        pass


# ───────────────────────────── 1 Library ─────────────────────────────
class LibraryTab(TabBody):
    table_id = "lib-table"
    BINDINGS = [
        Binding("space", "toggle", "Select"), Binding("i", "install", "Install"),
        Binding("p", "add_to_pack", "Add to pack"), Binding("w", "warnings", "Warnings"),
        Binding("escape", "clear_sel", "Clear sel", show=False), Binding("slash", "search", "Search"),
    ]

    def compose(self) -> ComposeResult:
        yield Input(placeholder="search: words · tag:web · src:redis · pack:core · nopack · installed", id="lib-search")
        with Horizontal():
            t = DataTable(id="lib-table", cursor_type="row", zebra_stripes=True)
            t.add_columns(" ", "skill", "source", "tags", "project", "packs")
            yield t
            with VerticalScroll(id="lib-preview-box"):
                yield Markdown(id="lib-preview")

    def on_mount(self) -> None:
        self.reload()

    def action_search(self) -> None:
        self.query_one("#lib-search").focus()

    def action_toggle(self) -> None:
        super().action_toggle()
        self.app_.sub(f"library: {len(self.keys)}/{len(self.app_.index)} skills · {len(self.selected)} selected")

    @on(Input.Changed, "#lib-search")
    def _search(self, _ev) -> None:
        self.reload()

    @on(Input.Submitted, "#lib-search")
    def _search_done(self, _ev) -> None:
        self.table.focus()

    def reload(self) -> None:
        q = self.query_one("#lib-search", Input).value.lower().split()
        pbs = self.app_.packs_map()
        st = self.app_.status_map()
        rows = []
        for r in self.app_.index:
            name, src, tags = r["name"], r["source"], r["tags"]
            packs = [p for p in pbs.get(name, [])]
            stack = [p for p in packs if not p.startswith("vendor/")]
            ok = True
            for w in q:
                if w.startswith("tag:"):
                    ok &= any(w[4:] in t for t in tags)
                elif w.startswith("src:"):
                    ok &= w[4:] in src.lower()
                elif w.startswith("pack:"):
                    ok &= any(w[5:] == p or w[5:] == p.split("/")[-1] for p in packs)
                elif w == "nopack":
                    ok &= not stack
                elif w == "installed":
                    ok &= name in st
                else:
                    ok &= w in f"{name} {src} {r['description']}".lower()
            if ok:
                state = st.get(name, "")
                rows.append((name, [name, src, ",".join(tags[:3]), styled(state) if state else "",
                                    ",".join(stack[:2]) + ("…" if len(stack) > 2 else "")]))
        self.fill(rows)
        self.app_.sub(f"library: {len(rows)}/{len(self.app_.index)} skills · {len(self.selected)} selected")

    @on(DataTable.RowHighlighted, "#lib-table")
    def _preview(self, ev: DataTable.RowHighlighted) -> None:
        name = ev.row_key.value if ev.row_key else None
        if not name:
            return
        try:
            text = (sc.SKILLS / name / "SKILL.md").read_text(errors="replace")[:20000]
        except OSError:
            text = "(missing)"
        src = sc.load_json(sc.SKILLS / name / "SOURCE.json")
        head = f"**{name}** · `{src.get('repo', sc.source_of(sc.SKILLS / name))}`"
        if src.get("commit"):
            head += f" @ `{src['commit'][:10]}`"
        self.query_one("#lib-preview", Markdown).update(head + "\n\n" + text)

    def action_install(self) -> None:
        names = self.targets()
        if names:
            self.app_.install_items([(n, None) for n in names], f"{len(names)} skill(s)", after=self.selected.clear)

    def action_add_to_pack(self) -> None:
        names = self.targets()
        if not names:
            return
        opts = [(p, sc.load_pack(p)["description"][:60]) for p in sc.list_packs()]

        def done(pack: str | None) -> None:
            if not pack:
                return
            pk = sc.load_pack(pack)
            pk["skills"] += [n for n in names if n not in pk["skills"]]
            sc.save_pack(pk)
            self.selected.clear()
            self.app_.refresh_all()
            self.app_.notify(f"added {len(names)} skill(s) to @{pack} (commit: git -C {sc.LIB} commit packs)")
        self.app_.push_screen(Pick(f"Add {len(names)} skill(s) to pack", opts), done)

    def action_warnings(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        e, w, _ = sc.check_skill(sc.SKILLS / k)
        self.app_.push_screen(TextView(f"validation: {k}", "\n".join([*(f"ERROR {x}" for x in e),
                                                                        *(f"WARN  {x}" for x in w)]) or "clean"))


# ───────────────────────────── 2 Packs ─────────────────────────────
class PacksTab(TabBody):
    table_id = "pack-table"
    BINDINGS = [
        Binding("i", "install", "Install pack"), Binding("u", "uninstall", "Remove from project"),
        Binding("n", "new", "New"), Binding("r", "rename", "Rename"), Binding("e", "edit", "Edit desc"),
        Binding("E", "extends", "Extends"), Binding("a", "add", "Add skill"), Binding("x", "remove", "Remove skill"),
        Binding("d", "delete", "Delete pack"), Binding("v", "toggle_vendor", "Vendor packs"),
    ]
    show_vendor = False

    def compose(self) -> ComposeResult:
        with Horizontal():
            t = DataTable(id="pack-table", cursor_type="row", zebra_stripes=True)
            t.add_columns(" ", "pack", "skills", "in project", "description")
            yield t
            with Vertical(id="pack-side"):
                yield Static("", id="pack-info", markup=False)
                m = DataTable(id="member-table", cursor_type="row", zebra_stripes=True)
                m.add_columns("skill", "project", "description")
                yield m

    def on_mount(self) -> None:
        self.reload()

    def reload(self) -> None:
        man = sc.read_manifest(self.app_.project)
        rows = []
        for p in sc.list_packs():
            if p.startswith("vendor/") and not self.show_vendor:
                continue
            try:
                pk = sc.load_pack(p)
                n = len(sc.expand_pack(p))
            except sc.SkillError as e:
                rows.append((p, [p, "ERR", "", str(e)]))
                continue
            rows.append((p, [p, str(n), styled("ok") if p in man["packs"] else "", pk["description"][:70]]))
        self.fill(rows)
        self._show_members(self.cursor_key())

    def action_toggle_vendor(self) -> None:
        self.show_vendor = not self.show_vendor
        self.reload()

    @on(DataTable.RowHighlighted, "#pack-table")
    def _hl(self, ev: DataTable.RowHighlighted) -> None:
        self._show_members(ev.row_key.value if ev.row_key else None)

    def _show_members(self, pack: str | None) -> None:
        m = self.query_one("#member-table", DataTable)
        self.reset_table(m)
        info = self.query_one("#pack-info", Static)
        if not pack:
            info.update("")
            return
        try:
            pk = sc.load_pack(pack)
            skills = sc.expand_pack(pack)
        except sc.SkillError as e:
            info.update(str(e))
            return
        idx = {r["name"]: r for r in self.app_.index}
        st = self.app_.status_map()
        tok = sum(sc.skill_tokens(sc.SKILLS / s) for s in skills if (sc.SKILLS / s).exists())
        info.update(f"@{pack}: {pk['description']}\nextends: {', '.join(pk['extends']) or '-'} · "
                    f"{len(skills)} skills · ≈{tok} tokens of descriptions\n"
                    f"install: skill-add @{pack}")
        own = set(pk["skills"])
        for s in skills:
            name = s if s in own else f"{s} (via extends)"
            state = st.get(s, "")
            m.add_row(name, styled(state) if state else "", idx.get(s, {}).get("description", "⚠ not in library")[:80], key=s)

    def _member_key(self) -> str | None:
        m = self.query_one("#member-table", DataTable)
        if not m.row_count or m.cursor_row is None:
            return None
        return m.coordinate_to_cell_key(Coordinate(m.cursor_row, 0)).row_key.value

    def action_install(self) -> None:
        for p in self.targets():
            try:
                items = sc.expand_items([f"@{p}"])
            except sc.SkillError as e:
                self.app_.notify(str(e), severity="error"); continue
            self.app_.install_items(items, f"@{p}")

    def action_uninstall(self) -> None:
        p = self.cursor_key()
        if p:
            self.app_.uninstall_pack(p)

    def action_new(self) -> None:
        def done(name: str | None) -> None:
            if not name:
                return
            try:
                if sc.pack_path(name).exists():
                    raise sc.SkillError("pack exists")
                sc.save_pack({"name": name, "description": "", "skills": []})
            except sc.SkillError as e:
                self.app_.notify(str(e), severity="error"); return
            self.reload()
            self.app_.notify(f"created @{name}; add skills with 'a' here or 'p' in Library")
        self.app_.push_screen(Ask("New pack name (kebab-case, optional group/):", placeholder="my-stack"), done)

    def action_rename(self) -> None:
        p = self.cursor_key()
        if not p:
            return

        def done(new: str | None) -> None:
            if new and new != p:
                try:
                    sc.rename_pack(p, new)
                except sc.SkillError as e:
                    self.app_.notify(str(e), severity="error"); return
                self.app_.refresh_all()
        self.app_.push_screen(Ask(f"Rename @{p} to:", p), done)

    def action_edit(self) -> None:
        p = self.cursor_key()
        if not p:
            return
        pk = sc.load_pack(p)

        def done(desc: str | None) -> None:
            if desc is not None:
                pk["description"] = desc
                sc.save_pack(pk)
                self.app_.refresh_all()
        self.app_.push_screen(Ask(f"Description of @{p}:", pk["description"]), done)

    def action_extends(self) -> None:
        p = self.cursor_key()
        if not p:
            return
        pk = sc.load_pack(p)

        def done(v: str | None) -> None:
            if v is None:
                return
            pk["extends"] = [x.lstrip("@") for x in v.replace(",", " ").split()]
            try:
                sc.save_pack(pk)
            except sc.SkillError as e:
                self.app_.notify(str(e), severity="error"); return
            self.reload()
        self.app_.push_screen(Ask(f"@{p} extends (space-separated packs):", " ".join(pk["extends"])), done)

    def action_add(self) -> None:
        p = self.cursor_key()
        if not p:
            return
        pk = sc.load_pack(p)
        opts = [(r["name"], f"[{r['source']}] {r['description'][:70]}") for r in self.app_.index if r["name"] not in pk["skills"]]

        def done(name: str | None) -> None:
            if name:
                pk["skills"].append(name)
                sc.save_pack(pk)
                self.app_.refresh_all()
                self.app_.notify(f"{name} → @{p}")
        self.app_.push_screen(Pick(f"Add skill to @{p}", opts), done)

    def action_remove(self) -> None:
        p, s = self.cursor_key(), self._member_key()
        if not p or not s:
            self.app_.notify("focus a skill in the member list (tab) first", severity="warning"); return
        pk = sc.load_pack(p)
        if s not in pk["skills"]:
            self.app_.notify(f"{s} comes from an extended pack; edit that pack instead", severity="warning"); return
        pk["skills"].remove(s)
        sc.save_pack(pk)
        self.app_.refresh_all()

    def action_delete(self) -> None:
        p = self.cursor_key()
        if not p:
            return

        def done(ok: bool) -> None:
            if ok:
                try:
                    sc.delete_pack(p)
                except sc.SkillError as e:
                    self.app_.notify(str(e), severity="error"); return
                self.app_.refresh_all()
                self.app_.notify(f"@{p} moved to trash")
        self.app_.push_screen(Confirm(f"Delete pack @{p}? (file goes to trash; skills are not touched)", danger=True), done)


# ───────────────────────────── 3 Project ─────────────────────────────
class ProjectTab(TabBody):
    table_id = "proj-table"
    BINDINGS = [
        Binding("space", "toggle", "Select"), Binding("u", "update", "Update"), Binding("U", "update_all", "Update all"),
        Binding("D", "diff", "Diff"), Binding("x", "uninstall", "Remove"), Binding("P", "uninstall_pack", "Remove pack"),
        Binding("a", "adopt", "Adopt"), Binding("t", "pin", "Pin/unpin"), Binding("l", "links", "Fix links"),
        Binding("s", "suggest", "Suggest"), Binding("o", "doctor", "Doctor"), Binding("c", "change", "Change project"),
        Binding("escape", "clear_sel", "Clear sel", show=False),
    ]

    def compose(self) -> ComposeResult:
        yield Static("", id="proj-info", markup=False)
        t = DataTable(id="proj-table", cursor_type="row", zebra_stripes=True)
        t.add_columns(" ", "skill", "state", "packs", "pin", "link", "source")
        yield t

    def on_mount(self) -> None:
        self.reload()

    def reload(self) -> None:
        d = self.app_.project
        st = self.app_.refresh_status()
        man = sc.read_manifest(d)
        tb = sc.token_budget(d)
        meter = "!! over budget" if tb["total"] > tb["budget"] else "ok"
        cnt: dict[str, int] = {}
        for r in st:
            cnt[r["state"]] = cnt.get(r["state"], 0) + 1
        self.query_one("#proj-info", Static).update(
            f"{d}\npacks: {', '.join(man['packs']) or '-'} · "
            + " ".join(f"{k}={v}" for k, v in sorted(cnt.items()))
            + f"\ndescriptions ≈ {tb['total']}/{tb['budget']} tokens ({tb['project_skills']} project + "
              f"{tb['global_skills']} global) {meter}")
        rows = []
        for r in st:
            src = man["skills"].get(r["name"], {}).get("source", "")
            rows.append((r["name"], [r["name"], styled(r["state"]), ",".join(r["packs"]) or ("manual" if r["manual"] else ""),
                                     "📌" if r["pinned"] else "", "" if r["link_ok"] else Text("broken", style="red"), src]))
        self.fill(rows)

    def _run(self, title: str, res) -> None:
        self.selected.clear()
        self.app_.refresh_all()
        self.app_.notify(fmt_results(res)[:400], title=title)

    def action_update(self) -> None:
        names = self.targets()
        if not names:
            return
        st = {r["name"]: r for r in self.app_.status}
        risky = [n for n in names if st.get(n, {}).get("state") in ("modified", "conflict")]
        if risky:
            def done(ok: bool) -> None:
                if ok:
                    self._run("update", sc.update_project(self.app_.project, names, force=True))
            self.app_.push_screen(Confirm(f"{', '.join(risky)} modified in project. Replace with library version? "
                                          "(old copy goes to trash)", danger=True), done)
        else:
            self._run("update", sc.update_project(self.app_.project, names))

    def action_update_all(self) -> None:
        self._run("update all outdated", sc.update_project(self.app_.project))

    def action_diff(self) -> None:
        k = self.cursor_key()
        if k:
            self.app_.push_screen(TextView(f"diff library ↔ project: {k}",
                                           sc.diff_text(sc.SKILLS / k, sc._dest(self.app_.project, k))))

    def action_uninstall(self) -> None:
        names = self.targets()
        if not names:
            return

        def done(ok: bool) -> None:
            if ok:
                self._run("remove", sc.uninstall(self.app_.project, names))
        self.app_.push_screen(Confirm(f"Remove {len(names)} skill(s) from project?\n{', '.join(names)}\n"
                                      "(moved to trash, restorable in tab 7)", danger=True), done)

    def action_uninstall_pack(self) -> None:
        man = sc.read_manifest(self.app_.project)
        if not man["packs"]:
            self.app_.notify("no packs installed"); return

        def done(p: str | None) -> None:
            if p:
                self.app_.uninstall_pack(p)
        self.app_.push_screen(Pick("Remove which pack from project?", [(p, "") for p in man["packs"]]), done)

    def action_adopt(self) -> None:
        self._run("adopt", sc.adopt(self.app_.project, [n for n in self.targets()
                                                         if any(r["name"] == n and r["state"] == "untracked" for r in self.app_.status)] or None))

    def action_pin(self) -> None:
        names = self.targets()
        st = {r["name"]: r for r in self.app_.status}
        pin = not all(st.get(n, {}).get("pinned") for n in names)
        self._run("pin" if pin else "unpin", sc.set_pin(self.app_.project, names, pin))

    def action_links(self) -> None:
        msgs = sc.repair_links(self.app_.project)
        self.app_.refresh_all()
        self.app_.notify("\n".join(msgs) or "links ok")

    def action_suggest(self) -> None:
        sg = sc.suggest_packs(self.app_.project)
        if not sg:
            self.app_.notify("no stack detected"); return

        def done(p: str | None) -> None:
            if p == "__all__":
                items = sc.expand_items([f"@{x}" for x, _ in sg])
                self.app_.install_items(items, " ".join(f"@{x}" for x, _ in sg))
            elif p:
                self.app_.install_items(sc.expand_items([f"@{p}"]), f"@{p}")
        opts = [("__all__", "install all suggested: " + " ".join(f"@{x}" for x, _ in sg))] + \
               [(p, f"({why}) · {len(sc.expand_pack(p))} skills") for p, why in sg]
        self.app_.push_screen(Pick("Suggested packs for this project", opts), done)

    def action_doctor(self) -> None:
        res = sc.doctor(self.app_.project)
        self.app_.push_screen(TextView("doctor", "\n".join(f"{ {'ok': '✓', 'warn': '!', 'error': '✗'}[lv]} {m}" for lv, m in res)))

    def action_change(self) -> None:
        def done(p: str | None) -> None:
            if not p:
                return
            try:
                self.app_.set_project(sc.resolve_project(p))
            except sc.SkillError as e:
                self.app_.notify(str(e), severity="error")
        self.app_.push_screen(Ask("Project directory:", str(self.app_.project)), done)


# ───────────────────────────── 4 Updates ─────────────────────────────
class UpdatesTab(TabBody):
    table_id = "upd-table"
    BINDINGS = [
        Binding("c", "check_all", "Check all"), Binding("k", "check_pack", "Check pack"),
        Binding("L", "check_lib_sel", "Check Library selection"), Binding("space", "toggle", "Select"),
        Binding("enter", "details", "Details"), Binding("a", "apply", "Apply selected"),
        Binding("A", "apply_safe", "Apply all safe"), Binding("r", "rollback", "Rollback"),
        Binding("f", "filter", "Only changes"), Binding("p", "projects", "Update projects"),
        Binding("escape", "clear_sel", "Clear sel", show=False),
    ]
    only_changes = True

    def __init__(self, **kw):
        super().__init__(**kw)
        self.items: dict[str, dict] = {}
        self.staged: dict[str, dict] = {}

    def compose(self) -> ComposeResult:
        yield Static("press c = check all upstream · k = one pack · L = skills selected in Library", id="upd-info", markup=False)
        t = DataTable(id="upd-table", cursor_type="row", zebra_stripes=True)
        t.add_columns(" ", "skill", "status", "repo", "commit", "risk")
        yield t

    def on_mount(self) -> None:
        for p in sc.load_pending():
            self.staged[p["name"]] = p
            self.items[p["name"]] = {**p, "status": "pending-risky"}
        self.reload()

    def reload(self) -> None:
        rows = []
        for n, it in sorted(self.items.items(), key=lambda kv: (kv[1]["status"] in ("up-to-date",), kv[0])):
            if self.only_changes and it["status"] == "up-to-date":
                continue
            risk = self.staged.get(n, {}).get("risk")
            rows.append((n, [n, styled(it["status"]), it.get("repo", ""),
                             f"{it.get('commit', '')[:8]}→{str(it.get('new_commit', ''))[:8]}",
                             Text("; ".join(risk)[:80], style="magenta") if risk else ("safe" if n in self.staged else "")]))
        self.fill(rows)

    def action_filter(self) -> None:
        self.only_changes = not self.only_changes
        self.reload()

    def _check(self, names: list[str] | None, label: str) -> None:
        self.query_one("#upd-info", Static).update(f"checking {label} …")
        self.run_check(names, label)

    @work(thread=True, exclusive=True, group="updates")
    def run_check(self, names, label) -> None:
        done = [0]

        def prog(repo, res):
            done[0] += 1
            self.app.call_from_thread(self.query_one("#upd-info", Static).update, f"checking {label} … {done[0]} repos ({repo})")
        rep = sc.check_updates(names, progress=prog)
        self.app.call_from_thread(self._checked, rep, label)

    def _checked(self, rep: dict, label: str) -> None:
        for it in rep["items"]:
            if it["name"] in self.staged and it["status"] != "changed":
                self.staged.pop(it["name"], None)
            self.items[it["name"]] = it
        cnt: dict[str, int] = {}
        for it in rep["items"]:
            cnt[it["status"]] = cnt.get(it["status"], 0) + 1
        msg = (f"{label}: " + ", ".join(f"{k}={v}" for k, v in sorted(cnt.items())) +
               f" · no upstream: {len(rep['no_upstream'])} · checked {rep['checked_at']}")
        if rep["errors"]:
            msg += f"\nerrors: {'; '.join(rep['errors'][:3])}"
        self.query_one("#upd-info", Static).update(msg + "\nenter = changelog + diff · a = apply selected · A = apply all safe")
        self.reload()

    def action_check_all(self) -> None:
        self._check(None, "all skills")

    def action_check_pack(self) -> None:
        def done(p: str | None) -> None:
            if p:
                self._check(sc.expand_pack(p), f"@{p}")
        self.app_.push_screen(Pick("Check updates for pack", [(p, "") for p in sc.list_packs()]), done)

    def action_check_lib_sel(self) -> None:
        lib = self.app_.query_one(LibraryTab)
        names = sorted(lib.selected)
        if not names:
            self.app_.notify("select skills in Library (tab 1, space) first", severity="warning"); return
        self._check(names, f"{len(names)} selected skills")

    @work(thread=True, exclusive=True, group="stage")
    def stage(self, names: list[str], then: str) -> None:
        for n in names:
            it = self.items.get(n)
            if not it or it["status"] not in ("changed", "pending-risky") or n in self.staged:
                continue
            self.app.call_from_thread(self.query_one("#upd-info", Static).update, f"staging {n} …")
            try:
                self.staged[n] = sc.stage_update(it)
            except sc.SkillError as e:
                self.app.call_from_thread(self.app.notify, f"{n}: {e}", severity="error")
        self.app.call_from_thread(self._staged, names, then)

    def _staged(self, names: list[str], then: str) -> None:
        self.reload()
        self.query_one("#upd-info", Static).update(f"staged {len([n for n in names if n in self.staged])} update(s)")
        if then == "details" and names and names[0] in self.staged:
            self._show_details(names[0])
        elif then == "apply":
            self._apply([self.staged[n] for n in names if n in self.staged])

    @on(DataTable.RowSelected, "#upd-table")
    def _selected(self, _ev) -> None:
        self.action_details()

    def action_details(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        if k in self.staged:
            self._show_details(k)
        elif self.items.get(k, {}).get("status") == "changed":
            self.stage([k], "details")
        else:
            self.app_.notify(f"{k}: {self.items.get(k, {}).get('status')}")

    def _show_details(self, k: str) -> None:
        s = self.staged[k]
        self.show_details(s)

    @work(thread=True, group="details")
    def show_details(self, s: dict) -> None:
        log = sc.changelog(s)
        text = (f"{s['name']}  {s['repo']}  {s['commit'][:12]} → {s['new_commit'][:12]}\n"
                f"risk: {'; '.join(s['risk']) or 'none (safe)'}\n"
                f"added: {', '.join(s['added']) or '-'}\nremoved: {', '.join(s['removed']) or '-'}\n"
                f"changed: {', '.join(s['changed_files']) or '-'}\n\nupstream changelog:\n{log}\n\n"
                + sc.diff_text(sc.SKILLS / s["name"], Path(s["staged"]), "current", "upstream"))
        self.app.call_from_thread(self.app.push_screen, TextView(f"update: {s['name']}", text))

    def action_apply(self) -> None:
        names = [n for n in self.targets() if self.items.get(n, {}).get("status") in ("changed", "pending-risky")]
        if not names:
            self.app_.notify("select changed skills (space) or put the cursor on one"); return
        self.stage(names, "apply")

    def action_apply_safe(self) -> None:
        names = [n for n, it in self.items.items() if it["status"] == "changed"]
        if not names:
            self.app_.notify("no changed skills — run a check first (c)"); return
        self._safe_only = True
        self.stage(names, "apply")

    def _apply(self, staged: list[dict]) -> None:
        safe_only = getattr(self, "_safe_only", False)
        self._safe_only = False
        safe = [s for s in staged if not s["risk"]]
        risky = [] if safe_only else [s for s in staged if s["risk"]]

        def go(allow_risky: bool) -> None:
            todo = safe + (risky if allow_risky else [])
            res = sc.apply_updates(todo, allow_risky=allow_risky)
            for n, ok, _ in res:
                if ok:
                    self.staged.pop(n, None)
                    self.items[n]["status"] = "up-to-date"
            pend = [s for s in self.staged.values() if s["risk"]]
            sc.save_pending(pend)
            self.app_.reindex()
            self.app_.refresh_all()
            aff = sc.projects_affected([n for n, ok, _ in res if ok])
            extra = ("\n\nprojects now outdated (press p):\n" + "\n".join(f"{p}: {', '.join(ns)}" for p, ns in aff)) if aff else ""
            self.app_.push_screen(TextView("apply updates", fmt_results(res) + extra))

        if risky:
            def choose(c: str | None) -> None:
                if c in ("all", "safe"):
                    go(c == "all")
            opts = [("safe", f"apply only the {len(safe)} safe update(s)" if safe else "(no safe updates)"),
                    ("all", f"apply ALL incl. {len(risky)} risky: " +
                     " | ".join(f"{s['name']}: {'; '.join(s['risk'])}" for s in risky)[:300]),
                    ("cancel", "do nothing (esc)")]
            self.app_.push_screen(Pick("Risky updates staged — choose (enter on Details first to review)", opts), choose)
        elif safe:
            self.app_.push_screen(Confirm(f"Apply {len(safe)} safe update(s) to the library and commit?"),
                                  lambda ok: go(False) if ok else None)
        else:
            self.app_.notify("nothing safe to apply")

    def action_rollback(self) -> None:
        k = self.cursor_key() or self.app_.query_one(LibraryTab).cursor_key()
        if not k:
            return

        def done(ok: bool) -> None:
            if ok:
                try:
                    msg = sc.rollback(k)
                except sc.SkillError as e:
                    self.app_.notify(str(e), severity="error"); return
                self.app_.reindex()
                self.app_.refresh_all()
                self.app_.notify(msg)
        self.app_.push_screen(Confirm(f"Roll back library skill {k} to its previous git version and pin it?"), done)

    def action_projects(self) -> None:
        aff = sc.projects_affected()
        if not aff:
            self.app_.notify("no registered project has outdated skills"); return

        def done(ok: bool) -> None:
            if ok:
                res = []
                for p, ns in aff:
                    res += [(f"{p.name}/{n}", ok_, m) for n, ok_, m in sc.update_project(p, ns)]
                self.app_.refresh_all()
                self.app_.push_screen(TextView("update projects", fmt_results(res)))
        self.app_.push_screen(Confirm("Update outdated skills in:\n" + "\n".join(f"{p}: {', '.join(ns)}" for p, ns in aff)
                                      + "\n(pinned and locally modified skills are skipped)"), done)


# ───────────────────────────── 5 Upstream candidates ─────────────────────────────
class UpstreamTab(TabBody):
    table_id = "cand-table"
    BINDINGS = [Binding("space", "tick", "Tick"), Binding("I", "import_", "Import ticked"),
                Binding("slash", "search", "Search"), Binding("t", "only_ticked", "Only ticked")]
    only_ticked = False

    def compose(self) -> ComposeResult:
        yield Input(placeholder="filter candidates: words · repo:owner · new (not in library)", id="cand-search")
        yield Static("", id="cand-info", markup=False)
        t = DataTable(id="cand-table", cursor_type="row", zebra_stripes=True)
        t.add_columns("✓", "skill", "repo", "flags", "description")
        yield t

    def on_mount(self) -> None:
        self.reload()

    def action_search(self) -> None:
        self.query_one("#cand-search").focus()

    @on(Input.Changed, "#cand-search")
    def _s(self, _ev) -> None:
        self.reload()

    @on(Input.Submitted, "#cand-search")
    def _sd(self, _ev) -> None:
        self.table.focus()

    def action_only_ticked(self) -> None:
        self.only_ticked = not self.only_ticked
        self.reload()

    def reload(self) -> None:
        self.cands = {str(c["line"]): c for c in sc.read_candidates()}
        lib = set(sc.library_names())
        q = self.query_one("#cand-search", Input).value.lower().split()
        rows = []
        for k, c in self.cands.items():
            have = c["name"] in lib
            ok = not self.only_ticked or c["ticked"]
            for w in q:
                if w.startswith("repo:"):
                    ok &= w[5:] in c["repo"].lower()
                elif w == "new":
                    ok &= not have
                else:
                    ok &= w in f"{c['name']} {c['repo']} {c['description']}".lower()
            if ok:
                rows.append((k, [c["name"], c["repo"], ("in library " if have else "") + c["flags"], c["description"][:90]]))
        t = self.table
        keep = self.cursor_key()
        self.reset_table(t)
        self.keys = []
        for k, cells in rows:
            t.add_row("x" if self.cands[k]["ticked"] else " ", *cells, key=k)
            self.keys.append(k)
        if keep in self.keys:
            t.move_cursor(row=self.keys.index(keep))
        n = sum(c["ticked"] for c in self.cands.values())
        self.query_one("#cand-info", Static).update(
            f"{len(rows)}/{len(self.cands)} candidates · {n} ticked · new upstream repos: add to staging/repos.txt, "
            "then run scripts/verify-repos.py")

    def action_tick(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        c = self.cands[k]
        if c["collides"] and not c["ticked"]:
            self.app_.notify(f"{c['name']} collides with an existing skill; importing needs --rename-collisions", severity="warning")
        sc.set_ticks({c["line"]: not c["ticked"]})
        c["ticked"] = not c["ticked"]
        t = self.table
        row = t.cursor_row
        t.update_cell_at(Coordinate(row, 0), "x" if c["ticked"] else " ")
        if row + 1 < t.row_count:
            t.move_cursor(row=row + 1)

    def action_import_(self) -> None:
        self.run_import(dry=True)

    @work(thread=True, exclusive=True, group="import")
    def run_import(self, dry: bool) -> None:
        cmd = [sys.executable, str(sc.TOOL_ROOT / "scripts/import-skills.py")] + (["--dry-run"] if dry else [])
        self.app.call_from_thread(self.query_one("#cand-info", Static).update, ("dry-run" if dry else "importing") + " …")
        r = subprocess.run(cmd, capture_output=True, text=True, env={**os.environ, "SKILL_LIBRARY": str(sc.LIB)})
        out = r.stdout + r.stderr
        if not dry:
            rows, e, w = sc.rebuild_index()
            out += f"\nvalidate: skills={len(rows)} errors={len(e)} warnings={len(w)}\n"
            out += "\n".join(f"pack problem {a}: {b}" for a, b in sc.validate_packs())
            out += f"\nreview, then commit: git -C {sc.LIB} add -A && git -C {sc.LIB} commit"
        self.app.call_from_thread(self._imported, dry, out)

    def _imported(self, dry: bool, out: str) -> None:
        if dry:
            n = out.count("DRY-RUN")

            def done(ok: bool) -> None:
                if ok:
                    self.run_import(dry=False)
            self.app_.push_screen(TextView("import dry-run", out),
                                  lambda _: self.app_.push_screen(Confirm(f"Import {n} skill(s) for real?"), done) if n else None)
        else:
            self.app_.reindex()
            self.app_.refresh_all()
            self.app_.push_screen(TextView("import result", out))
        self.reload()


# ───────────────────────────── 6 Validation ─────────────────────────────
class ValidationTab(TabBody):
    table_id = "val-table"
    BINDINGS = [Binding("v", "revalidate", "Re-validate"), Binding("enter", "jump", "Open in Library"),
                Binding("slash", "search", "Search")]

    def compose(self) -> ComposeResult:
        yield Input(placeholder="filter: words · error · review · link · lines", id="val-search")
        yield Static("", id="val-info", markup=False)
        t = DataTable(id="val-table", cursor_type="row", zebra_stripes=True)
        t.add_columns(" ", "level", "skill", "finding")
        yield t

    def on_mount(self) -> None:
        self.reload()

    def action_search(self) -> None:
        self.query_one("#val-search").focus()

    @on(Input.Changed, "#val-search")
    def _s(self, _ev) -> None:
        self.reload()

    def reload(self) -> None:
        import re
        p = sc.LIB / "VALIDATION.md"
        lines = p.read_text().splitlines() if p.exists() else []
        q = self.query_one("#val-search", Input).value.lower().split()
        rows, cnt = [], {}
        for i, line in enumerate(lines):
            m = re.match(r"^- (ERROR|WARN) `([^`]+)`: (.*)$", line)
            if not m:
                continue
            lvl, name, msg = m.groups()
            cat = "review" if msg.startswith("REVIEW") else ("link" if "broken link" in msg else ("lines" if "lines >" in msg else "other"))
            cnt[cat] = cnt.get(cat, 0) + 1
            if all(w in f"{lvl} {name} {msg} {cat}".lower() for w in q):
                rows.append((f"{i}", [Text(lvl, style="red" if lvl == "ERROR" else "yellow"), name, msg]))
        self.names = {k: c[1] for k, c in rows}
        self.fill(rows)
        self.query_one("#val-info", Static).update((lines[2] if len(lines) > 2 else "no report") + " · " +
                                                   " ".join(f"{k}={v}" for k, v in sorted(cnt.items())))

    def action_revalidate(self) -> None:
        self.app_.reindex(rebuild=True)
        self.reload()
        self.app_.notify("re-validated")

    @on(DataTable.RowSelected, "#val-table")
    def _selected(self, _ev) -> None:
        self.action_jump()

    def action_jump(self) -> None:
        k = self.cursor_key()
        if k:
            self.app_.open_in_library(self.names[k])


# ───────────────────────────── 7 Trash ─────────────────────────────
class TrashTab(TabBody):
    table_id = "trash-table"
    BINDINGS = [Binding("R", "restore", "Restore"), Binding("x", "delete", "Delete forever"),
                Binding("E", "empty", "Empty trash"), Binding("D", "view", "View diff vs library")]

    def compose(self) -> ComposeResult:
        yield Static("removed project skills, replaced copies and deleted packs", markup=False)
        t = DataTable(id="trash-table", cursor_type="row", zebra_stripes=True)
        t.add_columns(" ", "when", "kind", "name", "reason", "project / origin")
        yield t

    def on_mount(self) -> None:
        self.reload()

    def reload(self) -> None:
        self.entries = {e["slot"]: e for e in sc.list_trash(self.app_.project)}
        self.fill([(s, [e.get("removed_at", "")[:16], e["kind"], e["name"], e.get("reason", ""),
                        e.get("project") or e.get("origin", "")]) for s, e in self.entries.items()])

    def action_restore(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        try:
            msg = sc.restore_trash(k)
        except sc.SkillError as e:
            self.app_.notify(str(e), severity="error"); return
        self.app_.refresh_all()
        self.app_.notify(msg)

    def action_view(self) -> None:
        k = self.cursor_key()
        if not k:
            return
        e = self.entries[k]
        payload = Path(k) / e["name"]
        if e["kind"] == "skill" and payload.is_dir():
            self.app_.push_screen(TextView(f"trash vs library: {e['name']}", sc.diff_text(sc.SKILLS / e["name"], payload, "library", "trash")))

    def action_delete(self) -> None:
        k = self.cursor_key()
        if not k:
            return

        def done(ok: bool) -> None:
            if ok:
                sc.empty_trash([k])
                self.reload()
        self.app_.push_screen(Confirm(f"Permanently delete trash entry {self.entries[k]['name']}?", danger=True), done)

    def action_empty(self) -> None:
        if not self.entries:
            return

        def done(ok: bool) -> None:
            if ok:
                n = sc.empty_trash(list(self.entries))
                self.reload()
                self.app_.notify(f"deleted {n} entries")
        self.app_.push_screen(Confirm(f"Permanently delete ALL {len(self.entries)} trash entries?", danger=True), done)


# ───────────────────────────── app ─────────────────────────────
class SkillMan(App):
    TITLE = "skillman"
    CSS = """
    Screen { layout: vertical; }
    TabbedContent { height: 1fr; }
    ContentSwitcher { height: 1fr; }
    TabPane { height: 1fr; padding: 0; }
    TabBody { height: 1fr; }
    TabBody > Horizontal { height: 1fr; }
    #lib-search, #cand-search, #val-search { margin: 0 0 0 0; }
    #sub { height: 1; color: $text-muted; padding: 0 1; }
    DataTable { height: 1fr; }
    #lib-table { width: 3fr; }
    #lib-preview-box { width: 2fr; border-left: solid $primary; padding: 0 1; }
    #pack-table { width: 1fr; }
    #pack-side { width: 1fr; border-left: solid $primary; }
    #pack-info, #proj-info, #upd-info, #cand-info, #val-info { height: auto; padding: 0 1; color: $text-muted; }
    #member-table { height: 1fr; }
    .dialog { width: 80%; height: auto; max-height: 80%; border: thick $primary; background: $surface; padding: 1 2; }
    .dialog.tall { height: 80%; }
    .dialog.full { width: 95%; height: 92%; }
    .dialog .msg { height: auto; max-height: 30; overflow-y: auto; }
    .dialog .buttons { height: auto; margin-top: 1; }
    .dialog Button { margin-right: 2; }
    .dialog .hint { color: $text-muted; }
    #pick-list { height: 1fr; }
    #tv { height: 1fr; }
    Confirm, Ask, Pick, TextView { align: center middle; }
    """
    BINDINGS = [
        Binding("1", "tab('t-lib')", "Library", show=False), Binding("2", "tab('t-packs')", "Packs", show=False),
        Binding("3", "tab('t-proj')", "Project", show=False), Binding("4", "tab('t-upd')", "Updates", show=False),
        Binding("5", "tab('t-up')", "Upstream", show=False), Binding("6", "tab('t-val')", "Validation", show=False),
        Binding("7", "tab('t-trash')", "Trash", show=False), Binding("ctrl+r", "reload", "Reload"),
        Binding("q", "quit", "Quit"),
    ]

    def __init__(self, project: Path):
        super().__init__()
        self.project = project
        self.index = sc.load_index()
        self.status: list[dict] = []
        self.refresh_status()

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("", id="sub", markup=False)
        with TabbedContent(initial="t-lib"):
            with TabPane("1 Library", id="t-lib"):
                yield LibraryTab()
            with TabPane("2 Packs", id="t-packs"):
                yield PacksTab()
            with TabPane("3 Project", id="t-proj"):
                yield ProjectTab()
            with TabPane("4 Updates", id="t-upd"):
                yield UpdatesTab()
            with TabPane("5 Upstream", id="t-up"):
                yield UpstreamTab()
            with TabPane("6 Validation", id="t-val"):
                yield ValidationTab()
            with TabPane("7 Trash", id="t-trash"):
                yield TrashTab()
        yield Footer()

    def on_mount(self) -> None:
        self.sub_title = str(self.project)
        probs = sc.validate_packs()
        if probs:
            self.notify(f"{len(probs)} pack problem(s), e.g. {probs[0][0]}: {probs[0][1]}", severity="warning")

    def sub(self, text: str) -> None:
        with_proj = f"{text} · project: {self.project}"
        try:
            self.query_one("#sub", Static).update(with_proj)
        except Exception:
            pass

    def refresh_status(self) -> list[dict]:
        self.status = sc.project_status(self.project)
        return self.status

    def packs_map(self) -> dict[str, list[str]]:
        key = tuple(sorted((str(p), p.stat().st_mtime_ns) for p in sc.PACKS.rglob("*.yaml"))) if sc.PACKS.is_dir() else ()
        if key != getattr(self, "_pk_key", None):
            self._pk_key, self._pk = key, sc.packs_by_skill()
        return self._pk

    def status_map(self) -> dict[str, str]:
        return {r["name"]: r["state"] for r in self.status}

    def reindex(self, rebuild: bool = False) -> None:
        if rebuild:
            sc.rebuild_index()
        self.index = sc.load_index()

    def refresh_all(self) -> None:
        self.refresh_status()
        for cls in (LibraryTab, PacksTab, ProjectTab, TrashTab):
            for w in self.query(cls):
                w.reload()

    def set_project(self, p: Path) -> None:
        self.project = p
        self.sub_title = str(p)
        self.refresh_all()
        self.notify(f"project: {p}")

    def open_in_library(self, name: str) -> None:
        self.action_tab("t-lib")
        self.query_one("#lib-search", Input).value = name

    def action_tab(self, tab: str) -> None:
        tc = self.query_one(TabbedContent)
        tc.active = tab
        # move focus into the new pane, otherwise focus left in the old pane switches it back
        tables = tc.get_pane(tab).query(DataTable)
        if tables:
            tables.first().focus()

    def action_reload(self) -> None:
        self.reindex()
        self.refresh_all()
        for w in self.query(UpstreamTab):
            w.reload()
        for w in self.query(ValidationTab):
            w.reload()
        self.notify("reloaded")

    def install_items(self, items: list[tuple[str, str | None]], label: str, after=None) -> None:
        tok = sum(sc.skill_tokens(sc.SKILLS / n) for n, _ in items if (sc.SKILLS / n).exists())
        tb = sc.token_budget(self.project)
        warn = f"\n⚠ descriptions would reach ≈{tb['total'] + tok}/{tb['budget']} tokens" if tb["total"] + tok > tb["budget"] else ""

        def done(ok: bool) -> None:
            if not ok:
                return
            try:
                res = sc.install(self.project, items)
            except sc.SkillError as e:
                self.notify(str(e), severity="error"); return
            if after:
                after()
            self.refresh_all()
            bad = [r for r in res if not r[1]]
            self.notify(f"{len(res) - len(bad)} installed/up to date, {len(bad)} failed" +
                        (("\n" + fmt_results(bad))[:400] if bad else ""), severity="error" if bad else "information")
        names = ", ".join(n for n, _ in items[:12]) + (" …" if len(items) > 12 else "")
        self.push_screen(Confirm(f"Install {label} into\n{self.project}\n({len(items)} skills: {names})"
                                 f"\n≈{tok} tokens of skill descriptions{warn}"), done)

    def uninstall_pack(self, pack: str) -> None:
        def done(ok: bool) -> None:
            if ok:
                res = sc.uninstall_pack(self.project, pack)
                self.refresh_all()
                self.notify(fmt_results(res)[:400], title=f"remove @{pack}")
        self.push_screen(Confirm(f"Remove @{pack} from project? Skills still used by another pack or added manually "
                                 "are kept; others go to trash.", danger=True), done)


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    try:
        proj = sc.resolve_project(args[0] if args else ".", git_root=not args)
    except sc.SkillError as e:
        print(f"skillman: {e}", file=sys.stderr)
        return 1
    SkillMan(proj).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
