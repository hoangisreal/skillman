#!/usr/bin/env bash
# skill-search <term>... — case-insensitive AND search over ~/skill-library/INDEX.md
# (name, tags, description, source). Prints: name  [tags]  summary
set -euo pipefail
IDX="${SKILL_LIBRARY:-$HOME/skill-library}/INDEX.md"
[ $# -ge 1 ] || { echo "usage: skill-search <term>..." >&2; exit 1; }
[ -f "$IDX" ] || { echo "skill-search: index missing: $IDX (run validate-library.py)" >&2; exit 1; }
awk -F' \\| ' -v q="$*" '
  BEGIN { n = split(tolower(q), t, /[[:space:]]+/) }
  /^\| [a-z0-9]/ && !/^\| skill \|/ {
    line = tolower($0); ok = 1
    for (i = 1; i <= n; i++) if (index(line, t[i]) == 0) { ok = 0; break }
    if (!ok) next
    name = $1; sub(/^\| /, "", name)
    d = $3; if (length(d) > 110) d = substr(d, 1, 107) "..."
    printf "%-34s [%s] %s\n", name, $2, d; hits++
  }
  END { if (!hits) { print "no matches" > "/dev/stderr"; exit 1 } }
' "$IDX"
