#!/usr/bin/env bash
# skill-add — copy skills or whole packs from the cold library into a project.
#   skill-add <name|@pack>... [target-dir]   (target-dir defaults to ".")
#   skill-add -C <dir> <name|@pack>...       (explicit target dir)
#   skill-add --force ...                    (replace an existing, different copy; old copy -> trash)
#   skill-add --list | --packs               (list library skills | packs)
#   skill-add --suggest [dir]                (suggest packs from the project's stack)
# Real copy  -> <dir>/.agents/skills/<name>/   (Codex, OpenCode; commit it)
# Rel. link  -> <dir>/.claude/skills/<name> -> ../../.agents/skills/<name>  (Claude Code)
# Tracked in <dir>/.agents/skill-manifest.json. Manage with: skillman (TUI) or skillcore.py -h
set -euo pipefail
ROOT="${SKILL_LIBRARY:-$HOME/skill-library}"
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CORE="$HERE/../scripts/skillcore.py"
[ -f "$CORE" ] || CORE="$ROOT/scripts/skillcore.py"
[ -f "$CORE" ] || { echo "skill-add: skillcore.py not found (next to $0 or in $ROOT/scripts)" >&2; exit 1; }
[ -d "$ROOT/skills" ] || { echo "skill-add: library not found: $ROOT (set SKILL_LIBRARY)" >&2; exit 1; }
case "${1:-}" in
  ""|-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list|--all-list) find "$ROOT/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' | xargs -n1 basename | sort; exit 0 ;;
  --packs) exec python3 "$CORE" packs ;;
  --suggest) shift; exec python3 "$CORE" suggest "${1:-.}" ;;
esac
exec python3 "$CORE" install "$@"
